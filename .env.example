# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=          # populated by: python cli.py auth tiktok
TIKTOK_POST_MODE=draft         # draft | direct

# OpenArt.ai (browser automation)
OPENART_EMAIL=
OPENART_PASSWORD=

# Claude CLI
CLAUDE_CLI_PATH=claude         # or full path e.g. /usr/local/bin/claude

# Storage
DB_PATH=./ai_tools.db
DOWNLOADS_DIR=./downloads

# Scheduler
SCHEDULE_INTERVAL_MINUTES=60
